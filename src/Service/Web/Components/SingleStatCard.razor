@rendermode InteractiveServer

@implements IDisposable

<div class="card shadow-sm border-0 rounded-3 h-100">
    <div class="card-body d-flex align-items-center">
        @if (!string.IsNullOrEmpty(this.IconClass))
        {
            <div class="p-3 rounded-circle bg-opacity-10 me-3 @($"bg-{this.ThemeColor} text-{this.ThemeColor}")" 
                 style="width: 56px; height: 56px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
                <i class="@this.IconClass"></i>
            </div>
        }
        <div>
            <h6 class="text-uppercase text-muted mb-1 small tracking-wide">@this.Title</h6>
            <h2 class="mb-0 fw-bold text-dark">@this.Value.ToString("N0")@this.ValueUnit</h2>
            
            @if (this.ShowPerSecond)
            {
                <span class="text-muted small">
                    @this.perSecondValue/s
                </span>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public double Value { get; set; } = 0.0d;

    [Parameter]
    public string ValueUnit { get; set; } = "";

    [Parameter]
    public string IconClass { get; set; } = "";

    [Parameter]
    public string ThemeColor { get; set; } = "primary";

    [Parameter]
    public bool ShowPerSecond { get; set; } = false;

    private PeriodicTimer? perSecondTimer;
    private double perSecondValue;
    private double lastValue;

    protected override Task OnInitializedAsync()
    {
        if (this.ShowPerSecond)
        {
            this.lastValue = this.Value;

            _ = this.UpdatePerSecond();
        }

        return Task.CompletedTask;
    }

    private async Task UpdatePerSecond()
    {
        this.perSecondTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        while (await this.perSecondTimer.WaitForNextTickAsync())
        {
            double newPerSecondValue = this.Value - this.lastValue;
            this.perSecondValue = newPerSecondValue;

            this.lastValue = this.Value;

            // TODO: Check
            //if (newPerSecondValue != this.perSecondValue)
            {
                await this.InvokeAsync(() => this.StateHasChanged());
            }
        }
    }

    public void Dispose()
    {
        this.perSecondTimer?.Dispose();
    }
}